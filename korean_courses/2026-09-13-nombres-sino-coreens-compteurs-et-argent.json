    {
      "korean": "만",
      "romanization": "man",
      "translation": "10 000 (dix mille)",
      "note": "Piège important : les Coréens comptent par tranches de 10 000 (만) et non de 1000. 100 000 = 십만 (10×만), pas 100천.",
      "backImage": "data:image/svg+xml;base64,"
    },
    {
      "korean": "원",
      "romanization": "won",
      "translation": "won (monnaie coréenne)",
      "note": "Toujours après le nombre sino-coréen : 오천 원 = 5000 wons.",
      "backImage": "data:image/svg+xml;base64,"
    },
    {
      "korean": "개",
      "romanization": "gae",
      "translation": "compteur générique pour les objets",
