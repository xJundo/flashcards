      "backImage": "data:image/svg+xml;base64,"
    },
    {
      "korean": "얼마예요?",
      "romanization": "eol ma ye yo",
      "translation": "Combien ça coûte ?",
      "note": "",
      "backImage": "data:image/svg+xml;base64,"
    },
    {
      "korean": "이거 얼마예요?",
      "romanization": "i geo eol ma ye yo",
      "translation": "Combien coûte ça ?",
      "note": "이거 = ceci/ça.",
      "backImage": "data:image/svg+xml;base64,"
    },
    {
      "korean": "주세요",
      "romanization": "ju se yo",
      "translation": "donnez-moi / s'il vous plaît",
