    {
      "korean": "사과 세 개 주세요",
      "romanization": "sa gwa se gae ju se yo",
      "translation": "Trois pommes s'il vous plaît",
      "note": "Structure : Objet + nombre natif + compteur + 주세요.",
      "backImage": "data:image/svg+xml;base64,"
    },
    {
      "korean": "오천 원이에요",
      "romanization": "o cheon wo ni e yo",
      "translation": "Ça fait 5000 wons",
