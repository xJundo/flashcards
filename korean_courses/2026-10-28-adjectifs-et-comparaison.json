{
  "title": "Adjectifs et comparaison",
  "date": "2026-10-28",
  "words": [
    {
      "korean": "좋아요",
      "romanization": "jo a yo",
      "translation": "c'est bien / c'est bon",
      "note": "Présent poli de 좋다 (bon/bien, infinitif)."
    },
    {
      "korean": "나빠요",
      "romanization": "na ppa yo",
      "translation": "c'est mauvais",
      "note": "Présent poli de 나쁘다 (mauvais, infinitif). Irrégulier en 으 : le ㅡ tombe, la voyelle précédente (ㅏ) impose 아요 → 나빠요."
    },
    {
      "korean": "커요",
      "romanization": "keo yo",
      "translation": "c'est grand",
      "note": "Présent poli de 크다 (grand, infinitif). Irrégulier en 으, sans voyelle précédente → 어요 par défaut."
    },
    {
      "korean": "작아요",
      "romanization": "ja ga yo",
      "translation": "c'est petit",
      "note": "Présent poli de 작다 (petit, infinitif). Régulier."
    },
    {
      "korean": "비싸요",
      "romanization": "bi ssa yo",
      "translation": "c'est cher",
      "note": "Présent poli de 비싸다 (cher, infinitif)."
    },
    {
      "korean": "싸요",
      "romanization": "ssa yo",
      "translation": "c'est pas cher / bon marché",
      "note": "Présent poli de 싸다 (pas cher, infinitif)."
    },
    {
      "korean": "예뻐요",
      "romanization": "ye ppeo yo",
      "translation": "c'est joli",
      "note": "Présent poli de 예쁘다 (joli, infinitif). Irrégulier en 으."
    },
    {
      "korean": "재미있어요",
      "romanization": "jae mi i sseo yo",
      "translation": "c'est amusant / intéressant",
      "note": ""
    },
    {
      "korean": "재미없어요",
      "romanization": "jae mi eop sseo yo",
      "translation": "c'est ennuyeux",
      "note": "Sens opposé de 재미있어요."
    },
    {
      "korean": "보다",
      "romanization": "bo da",
      "translation": "que (particule de comparaison)",
      "note": "Attention, homophone du verbe 보다 (voir) ! Ici c'est une particule : A가 B보다 더 [adjectif] = A est plus [adjectif] que B."
    },
    {
      "korean": "이게 저거보다 더 예뻐요",
      "romanization": "i ge jeo geo bo da deo ye ppeo yo",
      "translation": "Celui-ci est plus joli que celui-là",
      "note": ""
    },
    {
      "korean": "제일 / 가장",
      "romanization": "je il / ga jang",
      "translation": "le plus (superlatif)",
      "note": "Deux mots strictement synonymes et interchangeables, pas deux sens différents. Se placent devant l'adjectif."
    },
    {
      "korean": "이게 제일 비싸요",
      "romanization": "i ge je il bi ssa yo",
      "translation": "C'est le plus cher",
      "note": ""
    },
    {
      "korean": "같아요",
      "romanization": "ga ta yo",
      "translation": "être pareil / identique",
      "note": ""
    },
    {
      "korean": "달라요",
      "romanization": "dal la yo",
      "translation": "c'est différent",
      "note": "Présent poli de 다르다 (être différent, infinitif). Irrégulier en 르 : on double le ㄹ. Classe d'irrégularité différente de 으 (à ne pas confondre)."
    },
    {
